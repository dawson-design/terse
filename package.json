{
  "name": "terse",
  "version": "1.0.0",
  "description": "Skills for the documents engineering leads write: ADRs, PRDs, tech specs, PR descriptions, review comments, emails, and Slack messages, each structured and sized to industry practice and written in your voice.",
  "type": "module",
  "keywords": [
    "writing",
    "adr",
    "prd",
    "design-doc",
    "pull-request",
    "code-review",
    "email",
    "slack",
    "codex",
    "claude-code",
    "agent-skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run test",
    "claudisms": "node scripts/claudisms.mjs",
    "eval": "node scripts/eval.mjs run --runs 5",
    "eval:quick": "node scripts/eval.mjs run --runs 1",
    "eval:case": "node scripts/eval.mjs run --runs 1 --case",
    "eval:preflight": "node scripts/eval.mjs preflight",
    "eval:score": "node scripts/eval.mjs score",
    "eval:judge": "node scripts/eval.mjs judge"
  },
  "devDependencies": {
    "vitest": "^3.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreek/terse.git"
  },
  "author": "Alastair Dawson",
  "license": "MIT"
}
