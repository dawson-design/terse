From 82f5317dd2c7f506a4e68ad6dc2d8f386b4e3fb4 Mon Sep 17 00:00:00 2001
From: Dana Reyes <dana@example.gov>
Date: Tue, 6 Oct 2026 15:12:00 +0000
Subject: [PATCH 1/3] Send an idempotency key with each claim submission

The intake API deduplicates POSTs that share an Idempotency-Key header
for 24 hours. Sending one means a claim resubmitted after a timeout no
longer creates a second record.

Refs #311
---
 src/claimClient.js | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/claimClient.js b/src/claimClient.js
index 929c276..dd8b389 100644
--- a/src/claimClient.js
+++ b/src/claimClient.js
@@ -1,14 +1,18 @@
 // Submits unemployment insurance claims to the state intake API.
+import { randomUUID } from 'node:crypto';
+
 export class ClaimClient {
 	constructor({ baseUrl, fetchImpl = fetch }) {
 		this.baseUrl = baseUrl;
 		this.fetch = fetchImpl;
 	}
 
-	async submit(claim) {
+	// The intake API treats POSTs that share an Idempotency-Key as one
+	// submission for 24 hours.
+	async submit(claim, { idempotencyKey = randomUUID() } = {}) {
 		const response = await this.fetch(`${this.baseUrl}/claims`, {
 			method: 'POST',
-			headers: { 'Content-Type': 'application/json' },
+			headers: { 'Content-Type': 'application/json', 'Idempotency-Key': idempotencyKey },
 			body: JSON.stringify(claim),
 		});
 		if (!response.ok) {
